{
  "$id": "https://github.com/dhuzard/oratlas-myst/schemas/oratlas-manifest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "oratlas.manifest.json — the portable ORAtlas interoperability and discovery document for one built MyST publication.",
  "properties": {
    "artifacts": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "additionalProperties": false,
          "properties": {
            "declarations": {
              "enum": [
                "publication-source",
                "review-manifest"
              ],
              "type": "string"
            },
            "format": {
              "const": "jsonl",
              "type": "string"
            },
            "path": {
              "maxLength": 512,
              "type": "string"
            },
            "records": {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "format",
            "records",
            "sha256",
            "declarations"
          ],
          "type": "object"
        }
      },
      "required": [
        "claims"
      ],
      "type": "object"
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "myst": {
      "additionalProperties": false,
      "properties": {
        "xref": {
          "maxLength": 512,
          "type": "string"
        }
      },
      "required": [
        "xref"
      ],
      "type": "object"
    },
    "oratlas": {
      "additionalProperties": false,
      "properties": {
        "reviewManifest": {
          "maxLength": 512,
          "type": "string"
        }
      },
      "required": [
        "reviewManifest"
      ],
      "type": "object"
    },
    "publication": {
      "additionalProperties": false,
      "properties": {
        "canonicalUrl": {
          "maxLength": 2000,
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "schemaVersion": {
      "const": "0.1.0",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "generator",
    "publication",
    "myst",
    "artifacts"
  ],
  "title": "ORAtlas MyST interoperability manifest",
  "type": "object"
}
